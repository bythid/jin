    { "name": "--jin-z-sticky", "group": "layers", "type": "number", "description": "z-index: sticky chrome" },
    { "name": "--jin-z-overlay", "group": "layers", "type": "number", "description": "z-index: drawer and friends" },
    { "name": "--jin-z-modal", "group": "layers", "type": "number", "description": "z-index: modal" },
    { "name": "--jin-z-toast", "group": "layers", "type": "number", "description": "z-index: toast / notification" },
    { "name": "--jin-z-tooltip", "group": "layers", "type": "number", "description": "z-index: tooltip" }
  ]
