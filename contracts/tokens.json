    { "name": "--jin-space-4", "group": "density", "type": "length", "description": "Space step 4" },
    { "name": "--jin-space-5", "group": "density", "type": "length", "description": "Space step 5" },
    { "name": "--jin-space-6", "group": "density", "type": "length", "description": "Space step 6" },
