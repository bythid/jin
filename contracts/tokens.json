    { "name": "--jin-font-weight-normal", "group": "typography", "type": "number", "description": "Normal weight" },
    { "name": "--jin-font-weight-medium", "group": "typography", "type": "number", "description": "Medium weight" },
    { "name": "--jin-font-weight-bold", "group": "typography", "type": "number", "description": "Bold weight" },
    { "name": "--jin-line-height", "group": "typography", "type": "number", "description": "Body line height" },
    { "name": "--jin-letter-spacing", "group": "typography", "type": "length", "description": "Letter spacing" },
    { "name": "--jin-text-transform", "group": "typography", "type": "keyword", "description": "none / uppercase (control labels)" },

