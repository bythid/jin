    { "name": "--jin-focus-ring-offset", "group": "focus", "type": "length", "description": "Keyboard focus ring offset" },

    { "name": "--jin-duration-fast", "group": "motion", "type": "time", "description": "Fast duration; 0s for brutalism" },
